* {
  bg0     : #1a1b1f; /* darker background */
  bg1     : #1f2027;
  bg2     : #242531;
  bg3     : #2c2e42;
  fg0     : #c0c0c5; /* softer text */
  fg1     : #a8a8b0;
  fg2     : #7a7a8a;
  red     : #f07178;
  green   : #95c973;
  yellow  : #e0b86c;
  blue    : #7aa2f7;
  magenta : #9c7ed0;
  cyan    : #4ab8b5;

  accent: @blue;     /* subtle accent for dark feel */
  urgent: @red;      /* alerts in red */
}

* {
    font: "CaskaydiaCove Nerd Font 14";

    background-color: transparent;
    text-color: @fg0;

    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    location: center;
    width: 480;
    y-offset: -20;

    border-radius: 7px;
    border: 1px;
    border-color: rgba(65, 72, 104, 0.7);

    background-color: rgba(26, 27, 38, 0.85);
    blur: true;
}

mainbox {
    padding: 1px;
    background-color: #1a1a1a;
}

inputbar {
    background-color: rgba(31, 35, 50, 0.85);
    border-radius: 7px;
    border: 1px;
    border-color: rgba(65, 72, 104, 0.7);

    padding: 8px 16px;
    spacing: 8px;
}

prompt {
    text-color: @cyan;
    background-color: transparent;
}

entry {
    text-color: @fg0;
    placeholder: "search";
    placeholder-color: @cyan;
    background-color: transparent;
}

listview {
    background-color: rgba(31, 35, 50, 0.85);
    margin: 12px 0 0;
    columns: 1;
    lines: 4;
    fixed-height: false;
}

element {
    padding: 6px 2px;
    spacing: 10px;
    border-radius: 12px;
    background-color: rgba(31, 35, 50, 0.85);
}

element normal urgent {
    text-color: @red;
}

element normal active {
    text-color: @blue;
}

element selected normal,
element selected active {
background-color: rgba(180, 190, 200, 0.16);
}

element-icon {
    size: 1em;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
    background-color: transparent;
}

message {
    margin: 12px 0 0;
    border-radius: 12px;
    border: 1px;
    border-color: rgba(65, 72, 104, 0.7);
    background-color: rgba(31, 35, 50, 0.85);
}

textbox {
    padding: 8px 24px;
    background-color: rgba(31, 35, 50, 0.85);
}
